

>>>VERTEX_SHADER

#version 450

//vertexbuffer attributes
layout(location = 0) in vec3 inPosition;
layout(location = 1) in vec2 inTexCoord;
layout(location = 2) in vec3 inNormal;
layout(location = 3) in vec3 inTangent;
layout(location = 4) in vec3 inBiTangent;


//instancebuffer attributes
layout(location = 5) in uint inMatindex;
layout(location = 6) in vec4 inTransformr0;
layout(location = 7) in vec4 inTransformr1;
layout(location = 8) in vec4 inTransformr2;


layout(location = 0) out VS_OUT {
    vec3 fragpos;
    vec2 UV;
    mat3 TBN;
} vs_out;  


layout(set = 0, binding = 0) uniform Scene {
	mat4 projection;
	mat4 view;
} scene;	

void main() {

    mat3 pure_transform = transpose(mat3(inTransformr0.xyz, inTransformr1.xyz, inTransformr2.xyz));
    mat4 transform = transpose(mat4(inTransformr0, inTransformr1, inTransformr2, vec4(0.0, 0.0, 0.0, 1.0)));
    
    vec4 positionv4 = scene.projection * scene.view * transform * vec4(inPosition, 1.0f);

    gl_Position = positionv4;

    vs_out.fragpos = positionv4.xyz;
    vs_out.UV = inTexCoord;

    vec3 T = normalize(pure_transform * inTangent);
    vec3 B = normalize(pure_transform * inBiTangent);
    vec3 N = normalize(pure_transform * inNormal);
    
    vs_out.TBN = mat3(T, B, N);
}

>>>FRAGMENT_SHADER

#version 450

layout(location = 0) in VS_OUT {
    vec3 fragpos;
    vec2 UV;
    mat3 TBN;
} fs_in;  

//output to color buffer
layout(location = 0) out vec4 outAlbedo;
layout(location = 1) out vec4 outNormal;

layout(set = 1, binding = 1) uniform sampler2D albedotexture;
layout(set = 1, binding = 2) uniform sampler2D normaltexture;

layout(set = 1, binding = 0) uniform MaterialProperties {
	vec2 UVscale;
    uint normalmap;
} materialproperties;	

void main() {	

    vec3 albedo = texture(albedotexture, fs_in.UV * materialproperties.UVscale).xyz;
    vec3 normaltexel = texture(normaltexture, fs_in.UV * materialproperties.UVscale).xyz;

    if(materialproperties.normalmap == 1) {
        normaltexel = normalize(normaltexel * 2.0 - 1.0);
    } else {
        normaltexel = vec3(0.0, 0.0, 1.0);
    }

    outAlbedo = vec4(albedo, 1.0f);
    outNormal = vec4(normalize(fs_in.TBN * normaltexel), 1.0f);
}

>>>END_OF_FILE